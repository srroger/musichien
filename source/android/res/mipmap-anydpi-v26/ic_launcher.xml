<?xml version="1.0" encoding="utf-8"?>
<!--
    Musichien - l'icone adaptative (Android 8 et plus).

    Le systeme decoupe l'icone selon la forme du lanceur - cercle, carre arrondi, goutte - et il a besoin de DEUX
    calques pour cela : un fond qui remplit tout, et un premier plan qu'il peut recadrer et animer.

    Le premier plan est le chien, place dans la ZONE SURE (les deux tiers du centre) : c'est ce qui garantit qu'aucune
    forme de lanceur ne lui coupe la tete. Le fond est le rose de l'illustration, pour qu'il n'y ait aucune couture
    visible quand le systeme recadre.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/musichien_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
