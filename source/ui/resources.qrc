<!--
  ====================================================================================================================
  Musichien - Qt resource file

  Embeds the QML files into the executable, so that they are loaded through "qrc:/qml/...".

  The prefix is "/" and the file keeps its "qml/" path on purpose: the resource path is then exactly
  the same as the path on disk, which removes a whole class of "file not found at run time" bugs.
  ====================================================================================================================
-->
<RCC>
    <qresource prefix="/">
        <file>qml/ExerciseScreen.qml</file>
        <file>qml/Main.qml</file>
        <!--
          The content files live at the root of the project, as docs/ARCHITECTURE.md requires, and the
          alias gives each one the runtime path it has on disk: ':/assets/content/...'. An alias rather
          than a relative path is what keeps the resource path identical to the real one, which is what
          removes a whole class of "found on the desktop, missing on the phone" bugs.
        -->
        <file alias="assets/content/interval-hints.json">../../assets/content/interval-hints.json</file>
        <file alias="assets/content/anecdotes.json">../../assets/content/anecdotes.json</file>
        <!--
          La police musicale, pour la clef de Sol. Le glyphe U+1D11E n'existe pas dans les polices Android par
          defaut (d'ou le rectangle), alors qu'il est dans Noto Music. Embarquee, elle rend la clef identique sur
          le PC et le telephone.
        -->
        <file alias="assets/fonts/NotoMusic-Regular.ttf">../../assets/fonts/NotoMusic-Regular.ttf</file>
    <!--
      Les echantillons d instruments : meme motif que les fichiers de contenu, alias compris,
      pour que le chemin de ressource soit celui du disque sur le PC comme sur le telephone.
    -->
        <file alias="assets/soundfonts/piano_c2.wav">../../assets/soundfonts/piano_c2.wav</file>
        <file alias="assets/soundfonts/piano_c3.wav">../../assets/soundfonts/piano_c3.wav</file>
        <file alias="assets/soundfonts/piano_c4.wav">../../assets/soundfonts/piano_c4.wav</file>
        <file alias="assets/soundfonts/piano_c5.wav">../../assets/soundfonts/piano_c5.wav</file>
        <file alias="assets/soundfonts/piano_c6.wav">../../assets/soundfonts/piano_c6.wav</file>
        <file alias="assets/soundfonts/guitare_c2.wav">../../assets/soundfonts/guitare_c2.wav</file>
        <file alias="assets/soundfonts/guitare_c3.wav">../../assets/soundfonts/guitare_c3.wav</file>
        <file alias="assets/soundfonts/guitare_c4.wav">../../assets/soundfonts/guitare_c4.wav</file>
        <file alias="assets/soundfonts/guitare_c5.wav">../../assets/soundfonts/guitare_c5.wav</file>
        <file alias="assets/soundfonts/guitare_c6.wav">../../assets/soundfonts/guitare_c6.wav</file>
        <file alias="assets/soundfonts/saxo_c2.wav">../../assets/soundfonts/saxo_c2.wav</file>
        <file alias="assets/soundfonts/saxo_c3.wav">../../assets/soundfonts/saxo_c3.wav</file>
        <file alias="assets/soundfonts/saxo_c4.wav">../../assets/soundfonts/saxo_c4.wav</file>
        <file alias="assets/soundfonts/saxo_c5.wav">../../assets/soundfonts/saxo_c5.wav</file>
    </qresource>
</RCC>
