# =====================================================================================================================
# Musichien - clang-tidy configuration
#
# Purpose: enforce the project's coding rules automatically, so that nobody (human or
# assistant) has to remember them and so that no false diff is ever produced.
#
# The naming rules below implement the project conventions:
#   - function parameters are prefixed with   p_
#   - class data members are prefixed with    m_
#   - everything is camelCase, types are CamelCase, constants are UPPER_CASE
#   - identifiers must be long enough to be meaningful (no "int i", no "string str")
#
# Usage: scripts/check_code.sh
# =====================================================================================================================
---
Checks: |
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-unchecked-optional-access,
  cert-*,
  clang-analyzer-*,
  -clang-analyzer-apiModeling.google.GTest,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  hicpp-*,
  misc-*,
  -misc-confusable-identifiers,
  -misc-unused-parameters,

  # misc-non-private-member-variables-in-classes flaggait nos AGREGATS DE DONNEES - Chord, Question, RhythmHit - dont
  # tout l'interet est justement d'etre un simple paquet de valeurs, sans invariant a proteger. Les transformer en
  # classes avec accesseurs ajouterait de la ceremonie sans rien garantir de plus.
  -misc-non-private-member-variables-in-classes,



  # misc-const-correctness is far too noisy on Qt code: adding const to a QObject based local
  # frequently breaks its signal/slot usage, for no real benefit.
  -misc-const-correctness,

  # misc-include-cleaner demands a direct #include for every std symbol used, including those pulled
  # in by our own headers. It produces thousands of findings on a healthy codebase.
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-return-braced-init-list,
  performance-*,
  # performance-enum-size is a micro-optimisation that would force a base type on every enum of the
  # domain, at the cost of readability. Not worth it at this stage.
  -performance-enum-size,
  readability-*,
  -readability-magic-numbers


  # ------------------------------------------------------------------------------------------------------------------
  # ATTENTION A L'ORDRE. Une exclusion placee AVANT sa famille est ANNULEE par elle : « -* », puis « modernize-* »,
  # puis « -modernize-use-designated-initializers » ne desactive RIEN, parce que la famille est rejouee apres. Les
  # exclusions vivent donc a la FIN de la liste, et jamais au milieu. Premiere passe du 01/10/2026 : c'est
  # exactement l'erreur qui a ete commise, et elle est couteuse - 110 trouvailles « ecartees » reapparues.
  # ------------------------------------------------------------------------------------------------------------------

  # ------------------------------------------------------------------------------------------------------------------
  # Regles ECARTEES APRES UNE PASSE SUR LES 214 TROUVAILLES DU PROJET (01/10/2026)
  # Le principe de cette passe : une regle se garde si ses trouvailles sont des RISQUES, et s'ecarte si elles sont du
  # BRUIT pour ce projet precis. Chaque ecart dit pourquoi, pour que la prochaine passe n'ait pas a le rediscuter.
  # ------------------------------------------------------------------------------------------------------------------

  # 110 trouvailles. Nos agregats de domaine - DroneFraming, BeatSchedule, ReminderMoment, QuestionTarget - ont deux a
  # quatre champs, declares quelques lignes au-dessus de leur usage, et ils sont DEJA initialises avec des constantes
  # nommees. Nommer les champs a chaque site ajouterait une ligne partout sans rien garantir de plus : l'ordre se lit.
  -modernize-use-designated-initializers,

  # 48 trouvailles. La regle veut un .at() PARTOUT, y compris un par echantillon dans le chemin audio. Dans les boucles
  # de traitement du signal et les tables, l'index est borne par construction, et c'est justement la que le cout se paie.
  # La regle du projet reste celle-ci, et elle est tenue : la ou un index vient de l'exterieur - preferences, contenu,
  # QML - le code utilise .at(). Voir docs/CODE_CONVENTIONS.md.
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,

  # 4 trouvailles, toutes dans la transformee de Fourier. Les algorithmes sur les BITS y sont l'essence meme du calcul,
  # et le signe de l'operande n'y a pas de sens.
  -hicpp-signed-bitwise,

  # 4 trouvailles : des methodes exposees au QML par Q_INVOKABLE ou des accesseurs de QObject, qui ne peuvent pas etre
  # statiques. La regle ne voit pas l'interface.
  -readability-convert-member-functions-to-static,

  # 2 trouvailles : la batterie de DrumSynthesizer est semee avec une graine CONSTANTE, et c'est VOULU. Une caisse claire
  # doit sonner pareil d'une fois a l'autre, sans quoi Roger ne pourrait plus comparer deux versions a l'oreille - qui
  # est exactement la facon dont il juge ce projet. Le projet ne fait aucune cryptographie : ces regles cert-* visent un
  # domaine qu'il n'a pas.
  -bugprone-random-generator-seed,
  -cert-msc32-c,
  -cert-msc51-cpp,

  # 1 trouvaille : QAudioPitchDetector::start, une machine a etats audio temps reel, mesure 26 la ou le seuil est a 25.
  # La decouper pour gagner un point de complexite se paierait en risque, sur le chemin ou le risque est le moins
  # souhaitable.
  -readability-function-cognitive-complexity,

WarningsAsErrors: ''
HeaderFilterRegex: 'Musichien[\/\\]source'
FormatStyle: file
UseColor: true

CheckOptions:

  # ------------------------------------------------------------------------------------------------------------------
  # Naming: functions and methods
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-naming.FunctionCase
    value: camelBack
  - key:   readability-identifier-naming.MethodCase
    value: camelBack
  - key:   readability-identifier-naming.IgnoreMainLikeFunctions
    value: '1'

  # ------------------------------------------------------------------------------------------------------------------
  # Naming: types
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.UnionCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumCase
    value: CamelCase
  - key:   readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key:   readability-identifier-naming.TypedefCase
    value: CamelCase
  - key:   readability-identifier-naming.TemplateParameterCase
    value: CamelCase

  # ------------------------------------------------------------------------------------------------------------------
  # Naming: enumerators and constants
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.ScopedEnumConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key:   readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key:   readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key:   readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case

  # ------------------------------------------------------------------------------------------------------------------
  # Naming: the m_ prefix rule, applied to class data members
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key:   readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key:   readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key:   readability-identifier-naming.ProtectedMemberPrefix
    value: 'm_'

  # Public members are deliberately NOT prefixed: plain data structs and QML exposed
  # types read better without a prefix. See docs/CODE_CONVENTIONS.md.
  - key:   readability-identifier-naming.PublicMemberCase
    value: camelBack
  - key:   readability-identifier-naming.PublicMemberPrefix
    value: ''
  - key:   readability-identifier-naming.StaticMemberCase
    value: camelBack
  - key:   readability-identifier-naming.StaticMemberPrefix
    value: ''

  # ------------------------------------------------------------------------------------------------------------------
  # Naming: the p_ prefix rule, applied to function parameters
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-naming.ParameterCase
    value: camelBack
  - key:   readability-identifier-naming.ParameterPrefix
    value: 'p_'

  # ------------------------------------------------------------------------------------------------------------------
  # Naming: variables
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-naming.VariableCase
    value: camelBack
  - key:   readability-identifier-naming.LocalVariableCase
    value: camelBack
  - key:   readability-identifier-naming.GlobalVariableCase
    value: camelBack

  # ------------------------------------------------------------------------------------------------------------------
  # Meaningful names: refuses opaque identifiers such as "it", "str" or "tmp"
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-identifier-length.MinimumVariableNameLength
    value: '3'
  - key:   readability-identifier-length.MinimumParameterNameLength
    value: '3'
  - key:   readability-identifier-length.MinimumLoopVariableNameLength
    value: '3'

  # ------------------------------------------------------------------------------------------------------------------
  # Braces are always required, including for a single statement body
  # ------------------------------------------------------------------------------------------------------------------
  - key:   readability-braces-around-statements.ShortStatementLines
    value: '0'
...
